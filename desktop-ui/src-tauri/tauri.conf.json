{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Tally",
  "version": "1.0.0",
  "identifier": "com.rayxworld.tally",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Tally",
        "width": 1100,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Rayxworld",
    "copyright": "Copyright (c) 2026 Rayxworld",
    "category": "Utility",
    "shortDescription": "Safe, undoable folder organizer",
    "longDescription": "Tally automatically sorts and organizes your messy folders into clean categories — with full undo, duplicate detection, and batch renaming. Zero data loss, always."
  }
}
